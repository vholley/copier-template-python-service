# Claude Code's local settings for this checkout. Anchored to the root so the
# template's own .claude/ (which ships to generated projects) stays tracked.
# This repository does not run the delivery process on itself.
/.claude/

# Python build artifacts
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.venv/

# Local copier test outputs
/tmp/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# Zip archives
*.zip

# Force-include template files that may be excluded by global gitignore
!template/.vscode/
!template/.vscode/**
