# Copy to .env for local development. Never commit .env — it is gitignored.
# Real secrets belong in Secret Manager, not here. Use .env only for non-sensitive
# local config: log levels, local service URLs, feature flags, throwaway settings.

# Override log level (default: INFO)
# LOG_LEVEL=DEBUG
{% if use_gcp %}
# GCP project used for local Secret Manager access.
# Defaults to your active gcloud project (gcloud config get-value project).
# GCP_PROJECT={{ gcp_project_dev }}
{% endif %}
# Add app-specific settings below as your project grows.
# MY_SERVICE_URL=http://localhost:9000
