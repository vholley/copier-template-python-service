repos:
  # Ruff and pyright come from the workspace, not from a pinned revision of their
  # own. A pinned hook builds an isolated environment at a version the lock file
  # knows nothing about, so the commit hook and `make green` format the same file
  # two different ways -- in on the way to the commit, back on the next green --
  # and a rule that exists in only one of the two versions fires in only one
  # place. --force-exclude keeps [tool.ruff] exclude honoured when pre-commit
  # passes filenames explicitly.
  - repo: local
    hooks:
      - id: ruff
        name: ruff check
        entry: uv run ruff check --fix --force-exclude
        language: system
        types_or: [python, pyi]
        require_serial: true
      - id: ruff-format
        name: ruff format
        entry: uv run ruff format --force-exclude
        language: system
        types_or: [python, pyi]
        require_serial: true
      - id: pyright
        name: pyright
        entry: uv run pyright
        language: system
        types_or: [python, pyi]
        pass_filenames: false
        require_serial: true

  # General file hygiene. These stay pinned: they are not tools the workspace
  # resolves, so there is no second version to disagree with.
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-toml
      - id: check-json
      - id: check-merge-conflict
      - id: check-added-large-files
        args: [--maxkb=500]
      - id: detect-private-key
      - id: mixed-line-ending
        args: [--fix=lf]

  # Conventional commits (commit-msg stage)
  - repo: https://github.com/compilerla/conventional-pre-commit
    rev: v3.6.0
    hooks:
      - id: conventional-pre-commit
        stages: [commit-msg]
        args: [feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert{% if enable_delivery %}, accept{% endif %}]
{%- if enable_delivery %}

  # Delivery checks (deterministic; the same scripts run in hooks and CI)
  - repo: local
    hooks:
      - id: delivery-constraints
        name: delivery constraints
        entry: env PYTHONPATH=scripts uv run python -m delivery.constraints
        language: system
        pass_filenames: false
        files: ^(libs|apps)/.*\.py$
      - id: delivery-budgets
        name: delivery budgets
        entry: env PYTHONPATH=scripts uv run python -m delivery.budgets
        language: system
        pass_filenames: false
      - id: delivery-accept-trailer
        name: acceptance trailer
        entry: env PYTHONPATH=scripts uv run python scripts/delivery/accept_trailer.py
        language: system
        stages: [commit-msg]
{%- endif %}
