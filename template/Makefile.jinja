	@echo "This stage is LLM work. In Claude Code, run: /entropy-audit"
{%- endif %}

# ---------------------------------------------------------------------------
# App scaffolding
# ---------------------------------------------------------------------------

.PHONY: new-app
new-app:  ## Scaffold a new app: make new-app NAME=<name>
	@if [ -z "$(NAME)" ]; then echo "Usage: make new-app NAME=<name>"; exit 1; fi
	@./scripts/new-app.sh "$(NAME)"
	@$(UV) sync
{%- if include_docker %}

# ---------------------------------------------------------------------------
# Container build
# ---------------------------------------------------------------------------

.PHONY: build
build:  ## Build the Docker image for an app: make build NAME=<name>
	@if [ -z "$(NAME)" ]; then echo "Usage: make build NAME=<name>"; exit 1; fi
	docker build -t {{ project_name }}-$(NAME):local -f apps/$(NAME)/Dockerfile .
{%- endif %}
{%- if use_gcp %}

# ---------------------------------------------------------------------------
# Deployment (canonical path is CI; this is for local testing)
# ---------------------------------------------------------------------------

.PHONY: deploy
deploy:  ## Deploy an app: make deploy NAME=<name> ENV=<dev|prod>
	@if [ -z "$(NAME)" ] || [ -z "$(ENV)" ]; then echo "Usage: make deploy NAME=<name> ENV=<dev|prod>"; exit 1; fi
	@./scripts/deploy.sh "$(NAME)" "$(ENV)"
{%- endif %}
{%- if include_terraform %}

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------

.PHONY: tf-plan
tf-plan:  ## Run terraform plan: make tf-plan ENV=<dev|prod>
	@if [ -z "$(ENV)" ]; then echo "Usage: make tf-plan ENV=<dev|prod>"; exit 1; fi
	cd infra/terraform/environments/$(ENV) && terraform init && terraform plan

.PHONY: tf-apply
tf-apply:  ## Run terraform apply: make tf-apply ENV=<dev|prod>
	@if [ -z "$(ENV)" ]; then echo "Usage: make tf-apply ENV=<dev|prod>"; exit 1; fi
	cd infra/terraform/environments/$(ENV) && terraform init && terraform apply
{%- endif %}

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

.PHONY: clean
clean:  ## Remove caches and build artifacts
	rm -rf .pytest_cache .ruff_cache .coverage htmlcov
	find . -type d -name __pycache__ -exec rm -rf {} +
