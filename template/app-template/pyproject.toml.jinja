[project]
name = "__APP_NAME__"
version = "0.1.0"
description = "App: __APP_NAME__"
requires-python = ">={{ python_version }}"
dependencies = [
    "shared",
    "httpx>=0.27.0",
{%- if app_framework == "fastapi" %}
    "fastapi>=0.115.0",
    "uvicorn[standard]>=0.30.0",
{%- endif %}
{%- if use_gcp %}
    "google-cloud-pubsub>=2.0",
{%- endif %}
]

[tool.uv.sources]
shared = { workspace = true }

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/__APP_NAME__"]
{%- if enable_delivery %}

[tool.delivery]
enabled = true
# test = "uv run pytest apps/__APP_NAME__"   # override when this app uses a different runner
{%- endif %}
