{% if use_gcp %}
terraform {
  backend "gcs" {
    bucket = "{{ gcp_project_prod }}-tfstate"
    prefix = "{{ project_name }}/prod"
  }
}
{%- else %}
# Configure your remote backend here, e.g.:
