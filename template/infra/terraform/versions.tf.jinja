terraform {
  required_version = ">= 1.10"

  required_providers {
{%- if use_gcp %}
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
{%- else %}
    # Add your cloud provider here, e.g.:
    # aws = {
    #   source  = "hashicorp/aws"
    #   version = "~> 5.0"
    # }
{%- endif %}
  }
}
