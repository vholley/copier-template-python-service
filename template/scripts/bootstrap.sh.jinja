#!/usr/bin/env bash
set -euo pipefail

# First-time setup for {{ project_name }}.
# Safe to re-run any time to verify environment state.

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info() { printf "${GREEN}==>${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}!! ${NC} %s\n" "$1"; }
fail() { printf "${RED}xx${NC} %s\n" "$1" >&2; exit 1; }

# ---------------------------------------------------------------------------
# macOS + Homebrew
# ---------------------------------------------------------------------------

if [[ "$(uname)" != "Darwin" ]]; then
    warn "Not running on macOS. This script targets macOS; results may vary."
fi

if ! command -v brew >/dev/null 2>&1; then
    fail "Homebrew not found. Install from https://brew.sh and re-run. See docs/SETUP.md for full setup."
fi

# ---------------------------------------------------------------------------
# uv (install if missing)
# ---------------------------------------------------------------------------

if ! command -v uv >/dev/null 2>&1; then
    info "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"
fi
info "uv: $(uv --version)"

# ---------------------------------------------------------------------------
# Python (pin to project version)
# ---------------------------------------------------------------------------

info "Installing Python {{ python_version }}..."
uv python install {{ python_version }}

# ---------------------------------------------------------------------------
# Workspace dependencies
# ---------------------------------------------------------------------------

info "Syncing workspace dependencies..."
uv sync

# ---------------------------------------------------------------------------
# pre-commit hooks
# ---------------------------------------------------------------------------

info "Installing pre-commit hooks..."
uv run pre-commit install --install-hooks
uv run pre-commit install --hook-type commit-msg

# ---------------------------------------------------------------------------
# VS Code extensions
# ---------------------------------------------------------------------------

VS_CODE_EXTENSIONS=(
    "ms-python.python"
    "ms-python.vscode-pylance"
    "charliermarsh.ruff"
    "tamasfe.even-better-toml"
    "redhat.vscode-yaml"
    "EditorConfig.EditorConfig"
    "github.vscode-github-actions"
    "mikestead.dotenv"
{%- if include_docker %}
    "ms-azuretools.vscode-docker"
{%- endif %}
{%- if include_terraform %}
    "hashicorp.terraform"
{%- endif %}
)

if command -v code >/dev/null 2>&1; then
    info "Installing VS Code extensions..."
    for ext in "${VS_CODE_EXTENSIONS[@]}"; do
        code --install-extension "$ext" --force >/dev/null && info "  $ext" || warn "  Failed to install $ext"
    done
else
    warn "VS Code CLI (code) not found — extensions will be suggested when you open the project."
    warn "To enable auto-install: open VS Code → Command Palette → 'Shell Command: Install code command in PATH'."
fi
{%- if use_gcp %}

# ---------------------------------------------------------------------------
# gcloud (verify auth and default project)
# ---------------------------------------------------------------------------

if ! command -v gcloud >/dev/null 2>&1; then
    warn "gcloud CLI not found. Manual installation required — bootstrap cannot install it automatically."
    warn "  1. brew install --cask google-cloud-sdk"
    warn "  2. gcloud init"
    warn "  3. gcloud auth application-default login"
    warn "See docs/SETUP.md (GCP section) for full setup steps. Re-run scripts/bootstrap.sh when done."
else
    info "gcloud: $(gcloud --version | head -1)"

    if ! gcloud auth application-default print-access-token >/dev/null 2>&1; then
        warn "No application-default credentials."
        warn "Run: gcloud auth application-default login"
    else
        info "Application-default credentials present."
    fi

    CURRENT_PROJECT="$(gcloud config get-value project 2>/dev/null || true)"
    if [[ -z "$CURRENT_PROJECT" ]]; then
        warn "No default gcloud project set."
        warn "Run: gcloud config set project {{ gcp_project_dev }}"
    else
        info "gcloud project: $CURRENT_PROJECT"
    fi
fi
{%- endif %}
{%- if include_docker %}

# ---------------------------------------------------------------------------
# Docker (presence check only)
# ---------------------------------------------------------------------------

if ! command -v docker >/dev/null 2>&1; then
    warn "Docker not found. Manual installation required — Docker Desktop needs user interaction to complete setup."
    warn "  1. brew install --cask docker"
    warn "  2. Open Docker Desktop and accept the license agreement"
    warn "See docs/SETUP.md (Containers section) for full setup steps. Re-run scripts/bootstrap.sh when done."
else
    info "docker: $(docker --version)"
fi
{%- endif %}
{%- if include_terraform %}

# ---------------------------------------------------------------------------
# Terraform (presence check only)
# ---------------------------------------------------------------------------

if ! command -v terraform >/dev/null 2>&1; then
    info "Installing Terraform..."
    brew install terraform
fi
info "terraform: $(terraform version | head -1)"
{%- endif %}

echo
info "Setup complete."
echo
echo "Next steps:"
echo "  make help                 # see all commands"
echo "  make new-app NAME=<name>  # create your first app"
echo "  make ci                   # verify lint + types + tests pass"
