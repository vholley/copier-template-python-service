#!/usr/bin/env bash
set -euo pipefail

# Restore files that are present in the template but missing from the
# current checkout — typically files gitignored by .gitignore (e.g. docs/,
# certain IDE configs) which are never pushed to GitHub and therefore
# absent after a fresh `git clone`.
#
# How it works:
#   1. Create a throwaway git worktree at the current HEAD.
#   2. Inside the worktree, run `copier recopy` to regenerate the full
#      template tree, including gitignored files.
#   3. Use `rsync --ignore-existing` to copy ONLY files that don't already
#      exist back into the real project. Tracked files are never touched.
#   4. Remove the worktree (also runs on error, via trap).
#
# Usage:
#   ./scripts/restore-from-template.sh           # interactive (prompts before restoring)
#   ./scripts/restore-from-template.sh --yes     # non-interactive (CI/scripting)

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info() { printf "${GREEN}==>${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}!! ${NC} %s\n" "$1"; }
fail() { printf "${RED}xx${NC} %s\n" "$1" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------

ASSUME_YES=0
for arg in "$@"; do
    case "$arg" in
        -y|--yes) ASSUME_YES=1 ;;
        -h|--help)
            sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) fail "Unknown argument: $arg (use --help for usage)" ;;
    esac
done

# ---------------------------------------------------------------------------
# Prerequisites
# ---------------------------------------------------------------------------

for cmd in git copier rsync; do
    command -v "$cmd" >/dev/null 2>&1 || fail "$cmd not found on PATH. Install it and re-run."
done

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || fail "Not inside a git repository. Run this from a project generated by copier."

cd "$PROJECT_ROOT"

[[ -f .copier-answers.yml ]] \
    || fail "No .copier-answers.yml in $PROJECT_ROOT. This script only works in projects generated by copier."

# ---------------------------------------------------------------------------
# Worktree
# ---------------------------------------------------------------------------

WORKTREE_DIR="$(mktemp -d -t copier-restore-XXXXXX)"

cleanup() {
    if [[ -d "$WORKTREE_DIR" ]]; then
        git -C "$PROJECT_ROOT" worktree remove --force "$WORKTREE_DIR" >/dev/null 2>&1 || true
        rm -rf "$WORKTREE_DIR" 2>/dev/null || true
    fi
}
trap cleanup EXIT

info "Creating temporary worktree at $WORKTREE_DIR"
git worktree add --quiet "$WORKTREE_DIR" HEAD

# ---------------------------------------------------------------------------
# Re-render template into the worktree
# ---------------------------------------------------------------------------

info "Re-rendering template (this re-creates gitignored files)"
(
    cd "$WORKTREE_DIR"
    copier recopy --skip-answered --overwrite --trust --quiet --vcs-ref=HEAD .
)

# ---------------------------------------------------------------------------
# Preview + confirm + restore
# ---------------------------------------------------------------------------

# --ignore-existing → only show files NOT already present in PROJECT_ROOT
# --itemize-changes + filter to lines starting with '>' keeps output to actual file transfers
PREVIEW="$(
    rsync -an --ignore-existing --itemize-changes \
        --exclude='.git/' \
        "$WORKTREE_DIR/" "$PROJECT_ROOT/" \
        | awk '/^>/ {print "  " $2}'
)"

if [[ -z "$PREVIEW" ]]; then
    info "Nothing to restore — project already matches the template."
    exit 0
fi

info "Files that would be restored:"
echo
printf '%s\n\n' "$PREVIEW"

if [[ "$ASSUME_YES" -ne 1 ]]; then
    printf "Restore these files? [y/N] "
    read -r reply
    case "$reply" in
        y|Y|yes|YES) ;;
        *) info "Cancelled — no changes made."; exit 0 ;;
    esac
fi

info "Restoring..."
rsync -a --ignore-existing \
    --exclude='.git/' \
    "$WORKTREE_DIR/" "$PROJECT_ROOT/"

info "Done."
