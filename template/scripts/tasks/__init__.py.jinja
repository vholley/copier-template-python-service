"""Project tasks, in Python so they run the same on macOS, Linux and Windows.

The Makefile calls these, so there is one implementation rather than a shell
script and a Windows equivalent that drift apart. On macOS and Linux use
`make <target>`; on Windows call `uv run python scripts/task.py <command>`.
"""

from __future__ import annotations

from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from collections.abc import Callable

# command -> (module attribute, one-line help)
COMMANDS: dict[str, tuple[str, str]] = {
    "bootstrap": ("bootstrap", "First-time setup: Python, dependencies, pre-commit, editor"),
    "new-app": ("new_app", "Scaffold a new app from app-template/: new-app <name>"),
    "restore": ("restore", "Restore gitignored template files missing after a clone"),
    "tf-bootstrap": ("tf_bootstrap", "Set up the Terraform state backend"),
{%- if use_gcp and include_docker %}
    "deploy": ("deploy", "Build and deploy an app to Cloud Run: deploy <name> <env>"),
{%- endif %}
{%- if enable_delivery %}
    "migrate": ("migrate", "Adopt the delivery system: migrate --from <generated-project>"),
{%- endif %}
}


def _load(name: str) -> Callable[[list[str]], int]:
    module = __import__(f"tasks.{COMMANDS[name][0]}", fromlist=["main"])
    return module.main  # type: ignore[no-any-return]


def usage() -> int:
    """Print the available commands."""
    print("usage: python scripts/task.py <command> [args]")
    print()
    print("Commands:")
    width = max(len(c) for c in COMMANDS)
    for name, (_module, help_text) in COMMANDS.items():
        print(f"  {name:<{width}}  {help_text}")
    print()
    print("On macOS and Linux these are also available as make targets.")
    return 0


def main(argv: list[str]) -> int:
    """Entry point: <command> [args]."""
    if not argv or argv[0] in ("-h", "--help", "help"):
        return usage()
    name = argv[0]
    if name not in COMMANDS:
        print(f"unknown command: {name}")
        print()
        usage()
        return 1
    return _load(name)(argv[1:])
