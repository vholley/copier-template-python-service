"""Deploy an app to Cloud Run (was scripts/deploy.sh)."""

from __future__ import annotations

import subprocess
from pathlib import Path

from tasks.console import error, info

REGION = "us-central1"
REPO = "{{ project_name }}"
PROJECTS = {
    "dev": "{{ gcp_project_dev }}",
    "prod": "{{ gcp_project_prod }}",
}


def main(argv: list[str]) -> int:
    """Entry point: <app_name> <env>."""
    if len(argv) != 2:
        error("usage: python scripts/task.py deploy <app_name> <env>   (env: dev | prod)")
        return 1
    name, env = argv
    project = PROJECTS.get(env)
    if project is None:
        error("env must be 'dev' or 'prod'")
        return 1

    repo = Path(__file__).resolve().parents[2]
    if not (repo / "apps" / name).is_dir():
        error(f"apps/{name} does not exist")
        return 1

    tag = subprocess.run(
        ["git", "rev-parse", "--short", "HEAD"],
        cwd=repo,
        text=True,
        capture_output=True,
        check=True,
    ).stdout.strip()
    image = f"{REGION}-docker.pkg.dev/{project}/{REPO}/{name}"

    steps: list[tuple[str, list[str]]] = [
        (
            "Configuring docker auth for Artifact Registry",
            ["gcloud", "auth", "configure-docker", f"{REGION}-docker.pkg.dev", "--quiet"],
        ),
        (
            f"Building {image}:{tag}",
            [
                "docker",
                "build",
                "-t",
                f"{image}:{tag}",
                "-t",
                f"{image}:latest",
                "-f",
                f"apps/{name}/Dockerfile",
                ".",
            ],
        ),
        ("Pushing image", ["docker", "push", f"{image}:{tag}"]),
        ("Pushing latest", ["docker", "push", f"{image}:latest"]),
        (
            f"Deploying to Cloud Run ({project})",
            [
                "gcloud",
                "run",
                "deploy",
                name,
                f"--project={project}",
                f"--region={REGION}",
                f"--image={image}:{tag}",
                "--platform=managed",
                "--no-allow-unauthenticated",
            ],
        ),
    ]
    for label, cmd in steps:
        info(label)
        r = subprocess.run(cmd, cwd=repo, check=False)
        if r.returncode != 0:
            error(f"{cmd[0]} failed with exit {r.returncode}")
            return r.returncode
    return 0
