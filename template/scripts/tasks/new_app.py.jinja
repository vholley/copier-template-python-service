"""Scaffold a new app from app-template/ (was scripts/new-app.sh)."""

from __future__ import annotations

import re
import shutil
from pathlib import Path

from tasks.console import error, info

NAME_RE = re.compile(r"^[a-z][a-z0-9_]*$")
PLACEHOLDER = "__APP_NAME__"
{%- if enable_delivery %}

CONTRACT = """
[[tool.importlinter.contracts]]
name = "LAYER-{name}: {name} layers depend forward only \
(working/architecture/constraints.md#layers)"
type = "layers"
layers = [
    "{name}.runtime",
    "{name}.service",
    "{name}.repo",
    "{name}.config",
    "{name}.types",
]
"""

SPEC = """# {name}
status: unspecified

Living specification for apps/{name}. Replace this file with statements
(one ## heading each, backed by a test marked spec("{name}.md#<anchor>"))
and remove the status line. Until then the member is reported as unspecified
and is not blocked.
"""
{%- endif %}


def _render_tree(target: Path, name: str) -> None:
    """Rename __APP_NAME__ directories depth-first, then substitute in file bodies."""
    dirs = [p for p in target.rglob("*") if p.is_dir() and p.name == PLACEHOLDER]
    for d in sorted(dirs, key=lambda p: len(p.parts), reverse=True):
        d.rename(d.with_name(name))
    for f in target.rglob("*"):
        if not f.is_file():
            continue
        raw = f.read_bytes()
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:
            continue  # binary file: leave it alone
        if PLACEHOLDER in text:
            f.write_text(text.replace(PLACEHOLDER, name), encoding="utf-8", newline="")
{%- if enable_delivery %}


def _add_layers_contract(repo: Path, name: str) -> None:
    """Append the import-linter contract and register the package, once."""
    pyproject = repo / "pyproject.toml"
    text = pyproject.read_text(encoding="utf-8")
    if f"LAYER-{name}:" in text:
        return
    text += CONTRACT.format(name=name)
    # root_packages is a single-line list literal.
    text = re.sub(
        r"^root_packages = \[(.*)\]",
        lambda m: f'root_packages = [{m.group(1)}, "{name}"]',
        text,
        count=1,
        flags=re.M,
    )
    pyproject.write_text(text, encoding="utf-8", newline="")


def _add_spec_skeleton(repo: Path, name: str) -> None:
    spec_dir = repo / "working" / "spec"
    spec_dir.mkdir(parents=True, exist_ok=True)
    spec = spec_dir / f"{name}.md"
    if not spec.exists():
        spec.write_text(SPEC.format(name=name), encoding="utf-8", newline="")
{%- endif %}


def main(argv: list[str]) -> int:
    """Entry point: <app_name>."""
    if len(argv) != 1:
        error("usage: python scripts/task.py new-app <app_name>")
        return 1
    name = argv[0]
    if not NAME_RE.match(name):
        error(
            "app name must be snake_case (lowercase letters, digits, underscores; "
            f"starts with a letter). Got: {name}"
        )
        return 1

    repo = Path(__file__).resolve().parents[2]
    template = repo / "app-template"
    target = repo / "apps" / name

    if target.exists():
        error(f"{target} already exists")
        return 1
    if not template.is_dir():
        error(f"{template} does not exist")
        return 1

    shutil.copytree(template, target)
    _render_tree(target, name)
{%- if enable_delivery %}
    _add_layers_contract(repo, name)
    _add_spec_skeleton(repo, name)
    info(
        f"Delivery: layers contract LAYER-{name} added; "
        f"working/spec/{name}.md created (unspecified)."
    )
{%- endif %}
    info(f"Created apps/{name}")
    print()
    print("Next: uv sync && make test")
    return 0
