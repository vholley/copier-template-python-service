#!/usr/bin/env bash
set -euo pipefail
{% if use_gcp %}
# Bootstrap Terraform state buckets for {{ project_name }}.
# One-time operation. Re-runnable; existing buckets are left alone.

DEV_PROJECT="{{ gcp_project_dev }}"
PROD_PROJECT="{{ gcp_project_prod }}"
REGION="us-central1"

bootstrap_bucket() {
    local project="$1"
    local bucket="${project}-tfstate"

    echo "==> ${bucket}"

    if gcloud storage buckets describe "gs://${bucket}" --project="${project}" >/dev/null 2>&1; then
        echo "    Already exists. Skipping create."
    else
        gcloud storage buckets create "gs://${bucket}" \
            --project="${project}" \
            --location="${REGION}" \
            --uniform-bucket-level-access
        echo "    Created."
    fi

    echo "    Enabling versioning..."
    gcloud storage buckets update "gs://${bucket}" --versioning >/dev/null
}

bootstrap_bucket "${DEV_PROJECT}"
bootstrap_bucket "${PROD_PROJECT}"

echo
echo "State buckets ready."
echo
echo "Next steps:"
echo "  cd infra/terraform/environments/dev"
echo "  terraform init"
echo "  terraform apply -var=\"github_repository=<owner/repo>\""
echo
echo "Then read the outputs and set them as GitHub environment variables"
echo "(see the 'GitHub repository setup' section of README.md)."
{%- else %}
# Set up Terraform state backend for {{ project_name }}.
#
# 1. Choose a remote backend and configure it in:
#      infra/terraform/environments/dev/backend.tf
#      infra/terraform/environments/prod/backend.tf
#
# 2. Initialise each environment:
#      cd infra/terraform/environments/dev && terraform init
#      cd infra/terraform/environments/prod && terraform init

echo "Configure your Terraform backend in:"
echo "  infra/terraform/environments/dev/backend.tf"
echo "  infra/terraform/environments/prod/backend.tf"
echo
echo "Then run:"
echo "  cd infra/terraform/environments/dev && terraform init"
echo "  cd infra/terraform/environments/prod && terraform init"
{%- endif %}
