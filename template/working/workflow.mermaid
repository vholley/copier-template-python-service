flowchart TD
    subgraph MACHINE["ON THE ENGINEER'S MACHINE — Claude Code session and shell.<br/>Purpose: define the work before code, then build it green.<br/>Everything here helps; nothing here is the final gate."]
        START["make start / /start<br/>What are you here to do?<br/>(asks only what applies to this branch)"]
        START -->|"A small fix with no change in behavior?<br/>(typo, docs, config, dependency bump)"| QC["edit on any branch<br/>no work item, no artifacts"]
        START -->|"Something the software will do differently?<br/>(new or changed behavior)"| INT
        START -->|"Something broken that should work?<br/>(a bug)"| INTD
        START -->|"Not sure yet, need to look first?"| SPIKE["exploration branch<br/>no checks, can never be merged"]
        SPIKE -->|"Found what to build or fix?<br/>make start again"| INT

        subgraph FRONT["DEFINING THE WORK BEFORE ANY CODE<br/>The engineer writes what is wanted, the agent finds the gaps,<br/>and the definition of done is agreed and signed.<br/>Files live in .work/&lt;id&gt;/ on the branch."]
            INT["/intent → intent.md<br/>what, why, constraints, non-goals, done"]
            INT --> ACC1{{"ENGINEER SIGNS<br/>make accept STAGE=intent"}}
            ACC1 --> CLR["/clarify<br/>Does this contradict what the system already does?<br/>What must be decided before building?<br/>(other unknowns are logged as assumptions with their risk)"]
            CLR --> DEC["decisions.md<br/>every decision: alternative + ramification"]
            DEC --> SPEC["/spec → spec.md + criteria.json<br/>What exactly will be true when this is done?<br/>(every criterion starts as failing and needs a test)"]
            SPEC --> ACC2{{"ENGINEER SIGNS<br/>make accept STAGE=spec<br/>(also accepts batched decisions)"}}
            ACC2 --> PLAN["/plan → interfaces + steps"]
            PLAN --> RED["/red → one failing test per criterion"]
            RED --> ACC3{{"ENGINEER SIGNS<br/>make accept STAGE=red"}}
        end

        subgraph DEFECTFRONT["DIAGNOSING A BUG BEFORE ANY FIX<br/>The cause must be shown, not guessed,<br/>before a line of the fix is written."]
            INTD["/intent → intent.md"] --> ACCD1{{"ENGINEER SIGNS<br/>make accept STAGE=intent"}}
            ACCD1 --> DIAG["/diagnose → diagnosis.md<br/>reproduce · evidence · cause with provenance<br/>source edits blocked until cause confirmed"]
            DIAG --> ACCD2{{"ENGINEER SIGNS<br/>make accept STAGE=diagnosis"}}
            ACCD2 --> PLAND["/plan"]
        end

        subgraph BUILD["BUILDING IT<br/>One step at a time; the session will not end<br/>with failing checks or unverified claims."]
            IMPL["/implement<br/>one plan step → make green → commit"]
            STOP{"stop hook<br/>green? evidence for criteria?"}
            IMPL --> STOP
            STOP -->|"Not yet, fewer than 3 tries?"| IMPL
            STOP -->|"Stuck after 3 tries?"| ESC["escalated: a human decides<br/>make status lists: implement · spec · abandon"]
            ESC --> IMPL
            STOP -->|"Green with evidence?"| EVAL["evaluator subagent<br/>fresh context, read-only,<br/>confirms each criterion from its evidence"]
        end
        ACC3 --> IMPL
        PLAND --> IMPL

        SIDE["anywhere on the machine:<br/>make status · make help · /amend (side loop, one criterion) · make abandon"]
    end

    EVAL -->|"Every criterion confirmed?<br/>open the PR"| PRDESC
    QC -->|"Done? open the PR"| PRDESC
    PRDESC["PR description<br/>intent + risk, diff mapped to criteria,<br/>decisions, evidence links"]

    subgraph GITHUB["ON GITHUB — pull request checks and branch rules.<br/>Purpose: the only gate that cannot be switched off.<br/>Checks artifacts in the PR, not the tool that made them."]
        TIER["Does this diff change behavior?<br/>(decided from the code, not from what anyone said:<br/>doc/config/test paths only, or code identical<br/>once comments are removed, or strings only = no)"]
        BOUNCE["bounced<br/>behavior change with no work item;<br/>message names make start + make adopt-branch"]
        CONTRACT["pr-contract check<br/>acceptance commits signed by an org member's key ·<br/>accepted files unchanged since signing ·<br/>intent accepted before any code, spec/diagnosis before implementation ·<br/>every criterion confirmed with evidence ·<br/>every decision has a ramification and an acceptance ·<br/>promotions and living-spec edits present · diff within budget ·<br/>no LLM co-author trailers · state.json agrees with rebuild"]
        CHECKS["mechanical checks<br/>ruff · pyright strict · tests · test ratchet ·<br/>import-linter + constraints · budgets ·<br/>spec coverage · diff coverage ·<br/>red-before-green ordering (defects: fix at diagnosed location)"]
        REVIEWERS["two read-only reviewer subagents<br/>necessity: which criterion requires each hunk?<br/>spec: does the delivered behavior match the intent?"]
        HUMAN{{"HUMAN REVIEWER<br/>1 did the spec solve the intent?<br/>2 were the accepted decisions sound?<br/>3 anything the spec did not require?<br/>records Intent-match: yes / partial / no"}}
        RULES["branch rules on develop<br/>PR required · all checks green ·<br/>code-owner review on protected paths ·<br/>1 approval (2 for high-risk) · no direct pushes"]
    end
    PRDESC --> TIER
    TIER -->|"No behavior change?"| CHECKS
    TIER -->|"Behavior change, but no work item?"| BOUNCE
    BOUNCE -.->|"Engineer creates the item and writes the definition;<br/>the code already written stays"| INT
    TIER -->|"Behavior change with a work item?"| CONTRACT --> CHECKS --> REVIEWERS --> HUMAN
    CHECKS -->|"No behavior change? straight to review"| HUMAN
    HUMAN --> RULES

    subgraph AFTER["AFTER MERGE — GitHub Actions on develop.<br/>Purpose: keep the repository's memory clean."]
        POST["post-merge job<br/>move .work/&lt;id&gt; → working/history/&lt;id&gt;<br/>delete progress.md<br/>(promotions were already in the diff)"]
        AUDIT["weekly entropy audit<br/>closed questions only; drafts, never commits"]
    end
    RULES -->|"Approved and all green? merge"| POST

    classDef human fill:#fff3cd,stroke:#b58900,color:#000
    classDef gate fill:#e7f0ff,stroke:#1f5fbf,color:#000
    classDef agent fill:#eef7ee,stroke:#2e7d32,color:#000
    class ACC1,ACC2,ACC3,ACCD1,ACCD2,HUMAN human
    class TIER,CONTRACT,CHECKS,RULES,STOP gate
    class CLR,SPEC,PLAN,RED,IMPL,DIAG,EVAL,REVIEWERS,PLAND,AUDIT agent
