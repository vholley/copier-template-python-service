flowchart TD
    START["make start / /start<br/>(contextual: asks only what applies)"]
    START -->|"quick change"| QC["edit on any branch<br/>no work item"]
    START -->|"add or change behavior"| INT
    START -->|"fix a bug"| INTD
    START -->|"explore first"| SPIKE["spike item<br/>guards off, never merges"]
    SPIKE -->|"make start: turn into..."| INT

    subgraph CHANGE["Change workflow (three signed acceptances)"]
        INT["/intent → intent.md"] --> ACC1{{"make accept STAGE=intent<br/>(engineer signs)"}}
        ACC1 --> CLR["/clarify<br/>contradictions first,<br/>bounded questions,<br/>assumptions logged"]
        CLR --> DEC["decisions.md<br/>alternative + ramification<br/>(no silent decisions)"]
        DEC --> SPEC["/spec → spec.md + criteria.json<br/>default-fail, required classes"]
        SPEC --> SR["spec-reviewer subagent<br/>(closed questions)"]
        SR --> ACC2{{"make accept STAGE=spec<br/>+ Accept-Decision trailers"}}
        ACC2 --> PLAN["/plan → interfaces + steps"]
        PLAN --> RED["/red → one failing test per criterion"]
        RED --> ACC3{{"make accept STAGE=red"}}
        ACC3 --> IMPL["/implement (green)<br/>one step, make green, commit"]
    end

    subgraph DEFECT["Defect variant"]
        INTD["/intent → intent.md"] --> ACCD1{{"make accept STAGE=intent"}}
        ACCD1 --> DIAG["/diagnose → diagnosis.md<br/>reproduce · evidence · cause with provenance<br/>source edits blocked until confirmed"]
        DIAG --> ACCD2{{"make accept STAGE=diagnosis"}}
        ACCD2 --> PLAND["/plan"] --> IMPL
    end

    IMPL --> STOP{"stop hook:<br/>make green passed?<br/>criteria have evidence?"}
    STOP -->|"no, retry < 3"| IMPL
    STOP -->|"no, retry = 3"| ESC["escalated<br/>(make status shows exits:<br/>implement · spec · abandon)"]
    ESC --> IMPL
    STOP -->|"yes"| EVAL["evaluator subagent<br/>fresh context, read-only,<br/>grades evidence per criterion"]
    EVAL -->|"all confirmed"| PR["open PR<br/>description = map of diff to criteria<br/>+ decisions + evidence"]

    QC --> PR

    subgraph CI["Tier 2: CI on the PR (the trust boundary)"]
        TIER["compute tier<br/>(paths · AST-equal · string-only)"]
        CONTRACT["pr-contract<br/>signatures · hashes · ordering<br/>criteria · decisions · promotions · budgets"]
        CHECKS["lint · pyright · tests · ratchet<br/>constraints · diff coverage"]
        REVIEWERS["necessity-reviewer<br/>spec-reviewer (read-only)"]
    end
    PR --> TIER
    TIER -->|"trivial"| CHECKS
    TIER -->|"standard, no item"| BOUNCE["bounced: message names<br/>make start + make adopt-branch"]
    BOUNCE --> INT
    TIER -->|"standard / high-risk"| CONTRACT --> CHECKS --> REVIEWERS
    REVIEWERS --> HUMAN["human reviewer:<br/>1 did the spec solve the intent?<br/>2 were the decisions sound?<br/>3 anything the spec did not require?<br/>Intent-match: yes/partial/no"]
    CHECKS -->|"trivial"| HUMAN
    HUMAN -->|"approve (2 for high-risk)"| MERGE["merge to develop"]
    MERGE --> POST["post-merge: archive .work/&lt;id&gt; → working/history/<br/>promotions already in the diff"]

    AMEND["/amend (side loop, any stage)<br/>one criterion at a time,<br/>re-accept only the affected part"] -.-> IMPL
    ABANDON["make abandon (any stage)<br/>archives with stage abandoned"] -.-> POST
    STATUS["make status (anywhere)<br/>branch · kind · stage · accepted · blocking · next command"]

    classDef human fill:#fff3cd,stroke:#b58900,color:#000
    classDef gate fill:#e7f0ff,stroke:#1f5fbf,color:#000
    classDef agent fill:#eef7ee,stroke:#2e7d32,color:#000
    class ACC1,ACC2,ACC3,ACCD1,ACCD2,HUMAN human
    class TIER,CONTRACT,CHECKS,STOP gate
    class CLR,SPEC,SR,PLAN,RED,IMPL,DIAG,EVAL,REVIEWERS,PLAND agent
